# ------------------------------------------------------------------
# Aura Voyage — Environment Configuration
# Copy this file to .env.local and fill in your own API keys.
# Never commit .env or .env.local — they are git-ignored by default.
# ------------------------------------------------------------------

# Google Gemini API key — powers the AI travel assistant + structured
# itinerary generation. Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenWeather API key — powers live weather + forecast widgets.
# Get one at https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=

# Unsplash Access Key — powers dynamic destination/attraction imagery.
# Get one at https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# Optional: legacy aliases some tooling looks for (kept in sync manually)
VITE_GEMINI_KEY=
VITE_OPENWEATHER_KEY=
VITE_UNSPLASH_KEY=
